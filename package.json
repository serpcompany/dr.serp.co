{
  "name": "dr.serp.co",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12 <23"
  },
  "scripts": {
    "predev": "node scripts/clean-next.mjs",
    "dev": "next dev",
    "build": "next build",
    "lint": "next lint",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build && node scripts/check-bundle-env.mjs",
    "cf:preview": "opennextjs-cloudflare build --env=preview && node scripts/check-bundle-env.mjs && opennextjs-cloudflare preview --env=preview",
    "cf:preview:dry-run": "opennextjs-cloudflare build --env=preview && node scripts/check-bundle-env.mjs && wrangler deploy --env preview --dry-run",
    "cf:deploy:dry-run": "opennextjs-cloudflare build --env=production && node scripts/check-bundle-env.mjs && wrangler deploy --env production --dry-run",
    "deploy:preview": "opennextjs-cloudflare build --env=preview && node scripts/check-bundle-env.mjs && opennextjs-cloudflare deploy --env=preview",
    "deploy:production": "opennextjs-cloudflare build --env=production && node scripts/check-bundle-env.mjs && opennextjs-cloudflare deploy --env=production",
    "cf:types": "wrangler types --env production --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:audit": "node scripts/cloudflare-migration-audit.mjs",
    "routes:manifest": "node scripts/generate-route-manifest.mjs",
    "routes:parity": "node scripts/compare-route-parity.mjs",
    "billing:prune-audit": "node scripts/prune-billing-audit.mjs",
    "billing:reconcile": "node scripts/reconcile-stripe-subscriptions.mjs",
    "webhook:health": "node scripts/check-webhook-health.mjs",
    "r2:replace-badges": "node scripts/replace-r2-badge-assets.mjs",
    "sites:purge-invalid": "node scripts/purge-invalid-site-domains.mjs",
    "sites:backfill-metadata": "node scripts/backfill-site-metadata.mjs",
    "docs:check": "node .github/scripts/check-docs.mjs && remark \"*.md\" \"docs/**/*.md\" --frail --quiet --use remark-validate-links"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.484.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-day-picker": "^9.6.7",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.1",
    "satori": "^0.19.1",
    "sonner": "^2.0.7",
    "stripe": "^14.25.0",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.2.4",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.38.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "wrangler": "^4.103.0"
  }
}
