{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./worker.ts",
  // Top level is local-only (wrangler dev, --local D1, opennextjs-cloudflare preview). It is never
  // deployed: every remote command passes --env staging or --env production. Named environments
  // inherit main, alias, the compatibility settings, keep_names, upload_source_maps and
  // observability; each repeats its own bindings, services and vars
  // (src/lib/wrangler-config.test.ts checks them).
  "name": "serp-dr-local",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // worker.ts imports the OpenNext build through this alias, so TypeScript never loads it.
  "alias": {
    "open-next-worker": "./.open-next/worker.js"
  },
  // esbuild's keep_names wraps functions in a __name() helper. next-themes turns a function into
  // an inline <script> that runs before React, where that helper doesn't exist (#130).
  "keep_names": false,
  "upload_source_maps": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "serp-dr-local"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serp-dr-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
      "migrations_table": "d1_migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimitDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1_rate_limit_durable_object",
      "new_sqlite_classes": ["RateLimitDurableObject"]
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "SITE_ENV": "local",
    "DR_PUBLIC_BASE_URL": "http://localhost:8787",
    "DR_BADGE_BASE_URL": "http://localhost:8787"
  },
  "secrets": {
    "required": [
      "AHREFS_API_KEY",
      "DR_ADMIN_TOKEN",
      "STRIPE_PRICE_IDS",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "USESEND_API_KEY",
      "USESEND_FROM",
      "USESEND_OTP_SECRET"
    ]
  },
  "env": {
    // Staging keeps the serp-dr-preview Worker and D1 names (AGENTS.md, Exceptions).
    "staging": {
      "name": "serp-dr-preview",
      "routes": [
        {
          "pattern": "staging-dr.serp.co",
          "custom_domain": true
        }
      ],
      // workers.dev stays on for CI, and worker.ts sends it to the canonical host.
      "workers_dev": true,
      "preview_urls": false,
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "serp-dr-preview"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "serp-dr-preview",
          "database_id": "e461f27e-6d8f-4bd3-9216-537e9642bad5",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimitDurableObject"
          }
        ]
      },
      "vars": {
        "NEXTJS_ENV": "production",
        "SITE_ENV": "staging",
        "DR_PUBLIC_BASE_URL": "https://staging-dr.serp.co",
        "DR_BADGE_BASE_URL": "https://staging-dr.serp.co",
        // Empty: Stripe's default portal configuration. Set an id in the same mode (live or test) as
        // Staging's STRIPE_SECRET_KEY to use a dr.serp.co one.
        "STRIPE_PORTAL_CONFIGURATION_ID": ""
      },
      "secrets": {
        "required": [
          "AHREFS_API_KEY",
          "DR_ADMIN_TOKEN",
          "STRIPE_PRICE_IDS",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "USESEND_API_KEY",
          "USESEND_FROM",
          "USESEND_OTP_SECRET"
        ]
      }
    },
    "production": {
      "name": "serp-dr",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "dr.serp.co",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "serp-dr"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "serp-dr-prod",
          "database_id": "0a6e5e69-60e4-4145-a84a-3f8c9177ad0c",
          "migrations_dir": "drizzle",
          "migrations_table": "d1_migrations"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimitDurableObject"
          }
        ]
      },
      "vars": {
        "NEXTJS_ENV": "production",
        "SITE_ENV": "production",
        "DR_PUBLIC_BASE_URL": "https://dr.serp.co",
        "DR_BADGE_BASE_URL": "https://dr.serp.co",
        // dr.serp.co's portal configuration on the shared live Stripe account; the default one is SERP Lists'.
        "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1UOMK3Ct1irzGjqBrv1778CI"
      },
      "secrets": {
        "required": [
          "AHREFS_API_KEY",
          "DR_ADMIN_TOKEN",
          "STRIPE_PRICE_IDS",
          "STRIPE_SECRET_KEY",
          "STRIPE_WEBHOOK_SECRET",
          "USESEND_API_KEY",
          "USESEND_FROM",
          "USESEND_OTP_SECRET"
        ]
      }
    }
  }
}
