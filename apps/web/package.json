{
  "name": "dr.serp.co",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.js.json",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "opennextjs-cloudflare build && node scripts/check-bundle-env.mjs",
    "preview": "opennextjs-cloudflare build && node scripts/check-bundle-env.mjs && opennextjs-cloudflare preview",
    "cf:staging:dry-run": "opennextjs-cloudflare build --env=staging && node scripts/check-bundle-env.mjs && wrangler deploy --env staging --dry-run",
    "cf:deploy:dry-run": "opennextjs-cloudflare build --env=production && node scripts/check-bundle-env.mjs && wrangler deploy --env production --dry-run",
    "deploy:staging": "opennextjs-cloudflare build --env=staging && node scripts/check-bundle-env.mjs && opennextjs-cloudflare deploy --env=staging",
    "deploy:production": "opennextjs-cloudflare build --env=production && node scripts/check-bundle-env.mjs && opennextjs-cloudflare deploy --env=production",
    "cf-typegen": "wrangler types --env production --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:audit": "node scripts/cloudflare-migration-audit.mjs",
    "routes:manifest": "node scripts/generate-route-manifest.mjs",
    "routes:parity": "node scripts/compare-route-parity.mjs",
    "billing:prune-audit": "node scripts/prune-billing-audit.mjs",
    "billing:reconcile": "node scripts/reconcile-stripe-subscriptions.mjs",
    "webhook:health": "node scripts/check-webhook-health.mjs",
    "r2:replace-badges": "node scripts/replace-r2-badge-assets.mjs",
    "sites:purge-invalid": "node scripts/purge-invalid-site-domains.mjs",
    "sites:backfill-metadata": "node scripts/backfill-site-metadata.mjs",
    "docs:check": "node ../../.github/scripts/check-docs.mjs && remark \"../../*.md\" \"../../docs/**/*.md\" AGENTS.md --frail --quiet --use remark-validate-links",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/local.sql",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "db:migrations:list:staging": "wrangler d1 migrations list DB --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production",
    "db:migrations:list:production": "wrangler d1 migrations list DB --remote --env production",
    "check": "pnpm lint && pnpm typecheck && pnpm db:check && pnpm test && pnpm cf:audit --strict --pretty && pnpm cf:build && pnpm docs:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.484.0",
    "next": "~16.3.8",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.0",
    "server-only": "0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.7",
    "stripe": "^14.25.0",
    "tw-animate-css": "^1.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4.1.8",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "happy-dom": "20.14.5",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "^4.139.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "brace-expansion@5": "^5.0.12",
      "minimatch@8": "^8.0.6",
      "nanoid@3": "^3.3.18",
      "picomatch@2": "^2.3.2",
      "postcss@8": "^8.5.23",
      "proxy-addr@2": "^2.0.8",
      "qs@6": "^6.16.0",
      "sharp@0.35": "^0.35.5",
      "source-map-js@1": "^1.2.2",
      "undici@7": "^7.29.1"
    }
  }
}
