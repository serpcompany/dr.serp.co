# Optional (client): where to reach the local DR proxy (defaults to http://localhost:5055)
VITE_AHREFS_PROXY_URL=http://localhost:5055
USESEND_API_KEY=
USESEND_FROM=DR Checker <no-reply@mail.serp.co>

USESEND_OTP_SECRET=

VITE_PUBLIC_BASE_URL=https://dr.serp.co
VITE_BADGE_BASE_URL=https://dr.serp.co
DR_PUBLIC_BASE_URL=https://dr.serp.co
DR_BADGE_BASE_URL=https://dr.serp.co

POSTGRES_URL=

# Optional shared store for rate limiting (recommended in multi-instance deployments)
RATE_LIMIT_REDIS_URL=

# Stripe (server)
STRIPE_SECRET_KEY=
# JSON map: {"monthly":{"12":"price_..."},"annual":{"12":"price_..."}}
STRIPE_PRICE_IDS=
# Optional, for webhook handling
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=

# Billing ops
CHECKOUT_RATE_LIMIT_POINTS=20
CHECKOUT_RATE_LIMIT_DURATION=60
BILLING_PORTAL_RATE_LIMIT_POINTS=10
BILLING_PORTAL_RATE_LIMIT_DURATION=60
STRIPE_WEBHOOK_RATE_LIMIT_POINTS=120
STRIPE_WEBHOOK_RATE_LIMIT_DURATION=60
STRIPE_WEBHOOK_STALE_HOURS=24
STRIPE_WEBHOOK_FAILURE_WINDOW_MINUTES=60
BILLING_AUDIT_RETENTION_DAYS=180
DR_ADMIN_TOKEN=

# Webhook health script (optional)
WEBHOOK_HEALTH_URL=

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
