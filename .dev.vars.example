# Copy to .dev.vars for local runs. npm run dev and the operator scripts load every key. Wrangler
# (wrangler dev, npm run cf:preview) loads only the keys in secrets.required in wrangler.jsonc,
# and takes DR_PUBLIC_BASE_URL and DR_BADGE_BASE_URL from wrangler.jsonc's vars; other keys fall
# back to their code defaults there.
# Never put these in .env* files: the OpenNext build copies .env* values into the Worker bundle.
# Deployed environments use Worker vars and secrets (wrangler secret put --env <env>).

USESEND_API_KEY=
USESEND_FROM=DR Checker <no-reply@mail.serp.co>

USESEND_OTP_SECRET=

# Local origin. Operator scripts call the admin API here unless DR_ADMIN_BASE_URL is set, so a
# deployed environment is only ever targeted on purpose.
DR_PUBLIC_BASE_URL=http://localhost:3000
DR_BADGE_BASE_URL=http://localhost:3000

# Ahrefs API v3 provider — enables live DR lookups.
# Uses GET /v3/site-explorer/domain-rating and consumes Ahrefs API units.
AHREFS_API_KEY=

# Stripe (server)
STRIPE_SECRET_KEY=
# JSON map: {"monthly":{"12":"price_..."},"annual":{"12":"price_..."}}
STRIPE_PRICE_IDS=
# Optional, for webhook handling
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=
# A portal configuration id in the same mode as STRIPE_SECRET_KEY; empty uses Stripe's default.
STRIPE_PORTAL_CONFIGURATION_ID=

# Billing ops
CHECKOUT_RATE_LIMIT_POINTS=20
CHECKOUT_RATE_LIMIT_DURATION=60
BILLING_PORTAL_RATE_LIMIT_POINTS=10
BILLING_PORTAL_RATE_LIMIT_DURATION=60
NEW_SITE_LOOKUP_RATE_LIMIT_POINTS=10
NEW_SITE_LOOKUP_RATE_LIMIT_DURATION=3600
NEW_SITE_LOOKUP_DAILY_LIMIT=100
VERIFY_OTP_RATE_LIMIT_POINTS=10
VERIFY_OTP_RATE_LIMIT_DURATION=600
RECHECK_RATE_LIMIT_POINTS=10
RECHECK_RATE_LIMIT_DURATION=60
STRIPE_WEBHOOK_RATE_LIMIT_POINTS=120
STRIPE_WEBHOOK_RATE_LIMIT_DURATION=60
STRIPE_WEBHOOK_STALE_HOURS=24
STRIPE_WEBHOOK_FAILURE_WINDOW_MINUTES=60
BILLING_AUDIT_RETENTION_DAYS=180
DR_ADMIN_TOKEN=

# Webhook health script (optional)
WEBHOOK_HEALTH_URL=
